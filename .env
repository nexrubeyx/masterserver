NODE_ENV=production
SERVER_NAME=ML Compatible Server

# Bind
SERVER_HOST=0.0.0.0
SERVER_PORT_WS=8080

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/mlgame
MONGODB_DB=mlgame

# Segurança
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX=200

# Jogo
DEFAULT_MAP_ID=mysterbox_imjxjosv
DEFAULT_X=16
DEFAULT_Y=15
MAP_VIEW_RADIUS_X=18
MAP_VIEW_RADIUS_Y=13
DEFAULT_SONG=rpgtitle

DEFAULT_BODY=1
DEFAULT_HAIR=1
DEFAULT_CLOTHES=1
DEFAULT_HAIR_COLOR=6504471
DEFAULT_CLOTHES_COLOR=14540253
DEFAULT_EYE_COLOR=9682175
DEFAULT_NAME_COLOR=16777215
DEFAULT_LEVEL=1
DEFAULT_CAVE_WALL=112
DEFAULT_CAVE_FLOOR=73

CLIENT_VERSION=5.1.2

# TLS direto no Node (opcional)
TLS_ENABLE=true
TLS_CERT_PATH=/etc/letsencrypt/live/client.dragonspheres.com.br/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/client.dragonspheres.com.br/privkey.pem
TLS_PORT=443
HTTP_REDIRECT_ENABLE=true
HTTP_REDIRECT_PORT=80

# Aumente o rate limit de entrada (mensagens do client -> servidor)

RATE_LIMIT_WINDOW_MS=5000
RATE_LIMIT_MAX=1000



# Loop e limites de rede
TICK_MS=50
SNAPSHOT_MAX_HZ=20

# Limite de frequência para MAP (chunk) por jogador (Hz)
MAP_MAX_HZ=20

# Segurança - Validação de Coordenadas
# Tolerância de coordenadas cliente/servidor (em tiles)
# 0 = Strict server authority (sem tolerância)
# 1-2 = Permite pequena diferença (compensar lag)
SECURITY_COORD_TOLERANCE=5
SECURITY_MAX_VIOLATIONS=5
SECURITY_HISTORY_SIZE=10
SECURITY_MAX_MOVE_DISTANCE=1
SECURITY_MIN_MOVE_INTERVAL=20

# Limite de violações para log de warn (apenas violações maiores que este valor são logadas)
# Evita spam de logs para pequenas diferenças causadas por lag
SECURITY_SIGNIFICANT_VIOLATION_THRESHOLD=2

# Timeout para jogadores dormindo (ms) - 60 segundos
SLEEP_TIMEOUT_MS=60000

# Intervalo de reconciliação de posições (ms) - padrão 5 segundos
# A cada X segundos, server envia lista completa de jogadores para garantir consistência
POSITION_RECONCILIATION_INTERVAL_MS=5000

# Velocidade padrão global (ms por tile). Menor = mais rápido.
DEFAULT_SPEED_MS=750